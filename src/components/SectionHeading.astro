---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  note?: string;
  href?: string;
  linkLabel?: string;
  inverse?: boolean;
}

const { id, eyebrow, title, note, href, linkLabel = "查看全部", inverse = false } = Astro.props;
---

<header class:list={["section-heading", { inverse }]}>
  <div>
    <span class="eyebrow">{eyebrow}</span>
    <h2 id={id}>{title}</h2>
    {note && <p>{note}</p>}
  </div>
  {href && <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true">↗</span></a>}
</header>
